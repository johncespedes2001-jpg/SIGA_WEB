# Persistencia: json (desarrollo) o sqlserver (institucional)
SIGA_STORAGE=sqlserver

# Opción A: cadena de conexión completa. No guarde una contraseña real en Git.
# SIGA_SQL_CONNECTION_STRING=Server=sql.instituto.edu.pe;Database=SIGA;User Id=siga_app;Password=CAMBIAR;Encrypt=true;TrustServerCertificate=false

# Opción B: parámetros separados.
SIGA_SQL_SERVER=127.0.0.1
SIGA_SQL_PORT=1433
SIGA_SQL_DATABASE=SIGA
SIGA_SQL_USER=siga_app
SIGA_SQL_PASSWORD=CAMBIAR_POR_UN_SECRETO_SEGURO
SIGA_SQL_ENCRYPT=true
SIGA_SQL_TRUST_CERTIFICATE=false
SIGA_REQUIRE_RELATIONAL_SYNC=true

# Genere al menos 48 bytes aleatorios en Base64URL; no reutilice la contraseña SQL.
SIGA_SESSION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES

# Dirección de escucha. Mantenga localhost salvo que necesite acceso desde otra computadora.
# SIGA_BIND_HOST=127.0.0.1

# Configuración normal de SIGA.
PORT=3000
# Producción requiere un proxy HTTPS. Use 1 cuando exista exactamente un proxy confiable.
SIGA_TRUST_PROXY=1
SIGA_PUBLIC_BASE_URL=https://siga.ejemplo.edu.pe
SIGA_DEMO_MODE=false
NODE_ENV=production
SIGA_BOOTSTRAP_ADMIN_NAME=Administrador SIGA
SIGA_BOOTSTRAP_ADMIN_EMAIL=administrador@instituto.edu.pe
SIGA_BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_POR_UN_SECRETO_SEGURO

# Escaneo obligatorio de archivos adjuntos en producción. Ejemplo con ClamAV/clamdscan.
SIGA_ANTIMALWARE_COMMAND=C:\Program Files\ClamAV\clamdscan.exe
SIGA_ANTIMALWARE_ARGS_JSON=["--no-summary","{file}"]
SIGA_ALERT_WEBHOOK=https://alertas.ejemplo.edu.pe/siga

# Información definitiva mostrada en el aviso de privacidad.
SIGA_LEGAL_NAME=CAMBIAR_POR_LA_RAZON_SOCIAL_INSTITUCIONAL
SIGA_LEGAL_ADDRESS=CAMBIAR_POR_EL_DOMICILIO_INSTITUCIONAL
SIGA_PRIVACY_EMAIL=CAMBIAR_POR_EL_CORREO_DE_PRIVACIDAD
SIGA_RETENTION_NOTICE=CAMBIAR_POR_LOS_PLAZOS_DE_CONSERVACION_APROBADOS
SIGA_DATA_RECIPIENTS=CAMBIAR_POR_DESTINATARIOS_Y_TRANSFERENCIAS_APROBADAS

