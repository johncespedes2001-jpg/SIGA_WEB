# Sustituya siga.institucion.edu.pe y las rutas del certificado antes de habilitar.
server {
  listen 80;
  server_name siga.institucion.edu.pe;
  return 308 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name siga.institucion.edu.pe;
  ssl_certificate /etc/letsencrypt/live/siga.institucion.edu.pe/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/siga.institucion.edu.pe/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 6m;

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 10s;
    proxy_read_timeout 65s;
  }
}
